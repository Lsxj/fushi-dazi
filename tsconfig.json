{
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "module": "CommonJS",
    "target": "ES2020",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "removeComments": true,
    "lib": ["ES2020"],
    "skipLibCheck": true
  },
  "include": ["./app.ts", "./data/**/*.ts", "./utils/**/*.ts", "./pages/**/*.ts", "./typings/**/*.ts", "./typings/**/*.d.ts"],
  "exclude": ["node_modules"]
}
