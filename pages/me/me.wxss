/* ============================================
   我的 · v2 token baseline
   全局 .page-bg / .card / token 见 app.wxss
   ============================================ */

.page-bg { padding-bottom: 120rpx; }

/* ============ Hero 卡(完全沿用首页 baby-card 同款样式) ============ */
.baby-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #FFFFFF;
  padding: 18rpx 24rpx;
  margin-top: 20rpx;
}
.baby-avatar {
  flex-shrink: 0;
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: #FFF1E3;
  display: flex;
  align-items: center;
  justify-content: center;
}
.baby-avatar-img { width: 104rpx; height: 104rpx; }
.baby-info { flex: 1; min-width: 0; }
.baby-name-wrap { line-height: 1.2; }
.baby-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #1A1815;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}
.baby-name-edit {
  font-size: 22rpx;
  color: var(--text-meta);
  margin-left: 6rpx;
  font-weight: 400;
}
.baby-name-edit:active { color: var(--orange); }
.baby-desc-editable {
  display: inline-flex;
  align-items: baseline;
  gap: 2rpx;
}
.baby-desc-tap {
  color: var(--text-mute);
  font-size: 22rpx;
}
.baby-name-input {
  font-size: 38rpx;
  font-weight: 700;
  color: #1A1815;
  border-bottom: 2rpx solid #FF6B35;
  padding: 0;
  height: 54rpx;
  line-height: 54rpx;
}
.baby-desc {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #8A847E;
  margin-top: 6rpx;
}
.baby-desc-item { color: #8A847E; }
.baby-desc-dot { color: #C9C4BD; }
.baby-pills {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}
.baby-pills-arrow {
  color: #C9C4BD;
  font-size: 28rpx;
  margin-left: 2rpx;
}

/* ============ 分组小标题 ============ */
.section-title {
  font-size: 24rpx;
  color: var(--text-meta);
  margin: 14rpx 12rpx 12rpx;
}

/* ============ 菜单卡（行列表） ============ */
.menu-card {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 0 22rpx;
  margin-bottom: 18rpx;
  box-shadow: var(--shadow-card);
}
.menu-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F5EBE0;
}
.menu-row:last-child { border-bottom: none; }
.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}
.icon-green  { background: var(--green-bg); }
.icon-orange { background: var(--bg-promo); }
.icon-yellow { background: var(--warn-bg); }
.icon-blue   { background: #E8F2FF; }
.icon-purple { background: #F0EAFE; }
.icon-red    { background: #FFEBEE; }
.menu-info { flex: 1; min-width: 0; }
.menu-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-h1);
}
.menu-name.danger { color: #E57373; }
.menu-sub {
  font-size: 22rpx;
  color: var(--text-meta);
  margin-top: 4rpx;
}
.menu-arrow {
  color: var(--text-mute);
  font-size: 32rpx;
}

/* ============ 底部 tip 卡 ============ */
.tip-card {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: var(--bg-tip);
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  margin-top: 20rpx;
}
.tip-card-emoji {
  font-size: 26rpx;
  flex-shrink: 0;
  line-height: 1.4;
}
.tip-card-text {
  flex: 1;
  font-size: 22rpx;
  color: #B17B2E;
  line-height: 1.5;
}
