/* ============================================
   辅食搭子首页 · 页面独有样式
   全局 token / .card / .pill / .btn-primary 等见 app.wxss
   ============================================ */

/* ============ Nav ============ */
.nav-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: var(--bg-page);
}
.nav-inner {
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.nav-brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.nav-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FFB07A 0%, #FF6B35 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 53, 0.25);
}
.nav-logo-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
}
.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1815;
  letter-spacing: 0.5rpx;
}
.nav-sparkle {
  font-size: 26rpx;
  color: #FF6B35;
  margin-left: 4rpx;
}
/* ============ 首页专用：card link 文本（非 pill） ============ */
.card-link {
  font-size: 24rpx;
  color: var(--orange);
  font-weight: 500;
  display: inline-flex;
  align-items: center;
}
.card-link-outline {
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 24rpx;
  border: 2rpx solid #FFD9BD;
  background: #FFFFFF;
  color: var(--text-yellow);
  font-size: 24rpx;
  font-weight: 500;
}
.link-arrow {
  margin-left: 2rpx;
  font-size: 24rpx;
}

/* ============ ① 宝宝信息卡 ============ */
.baby-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #FFFFFF;
  padding: 18rpx 24rpx;
}
.baby-avatar {
  flex-shrink: 0;
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: #FFF1E3;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.baby-avatar-img { width: 104rpx; height: 104rpx; }
.baby-info { flex: 1; min-width: 0; }
.baby-name-wrap { line-height: 1.2; }
.baby-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #1A1815;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}
.baby-name-sym {
  font-size: 26rpx;
  color: #4FA3E8;
  font-weight: 600;
}
.baby-name-input {
  font-size: 38rpx;
  font-weight: 700;
  color: #1A1815;
  border-bottom: 2rpx solid #FF6B35;
  padding: 0;
  height: 54rpx;
  line-height: 54rpx;
}
.baby-desc {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #8A847E;
  margin-top: 6rpx;
}
.baby-desc-item { color: #8A847E; }
.baby-desc-dot { color: #C9C4BD; }
.baby-pills {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}
.baby-pills-arrow {
  color: #C9C4BD;
  font-size: 28rpx;
  margin-left: 2rpx;
}

/* ============ ② 今日不适追踪（已记录态用 .discomfort-promo 同款 layout） ============ */
.discomfort-count {
  color: var(--orange-deep);
  font-weight: 700;
}

/* 不适引流入口（无记录态） —— 紧凑版：插画左 + 文案中 + 橙CTA右
   背景跟设计图对齐：浅橙桃 #FFEDD9 比 #FFF5EC 更橙，跟卡片白底有明显区分 */
.discomfort-promo {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 18rpx;
  background: #FFEDD9;
  border: none;
}
.discomfort-promo-img {
  flex-shrink: 0;
  display: block;
  width: 96rpx;
  height: 72rpx;
  /* 图视觉重心偏下（记录本主体在下、心心在右上），
     transform 微下移让视觉对齐文字中线，不占布局空间不撑高卡片 */
  transform: translateY(8rpx);
}
.discomfort-promo-body {
  flex: 1;
  min-width: 0;
}
.discomfort-promo-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1815;
  margin-bottom: 4rpx;
  letter-spacing: 0.2rpx;
}
.discomfort-promo-desc {
  font-size: 20rpx;
  color: #8A847E;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.discomfort-promo-cta {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 28rpx;
  background: var(--orange-grad);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.28);
}
.discomfort-promo-cta-arrow {
  margin-left: 3rpx;
  font-size: 22rpx;
  font-weight: 400;
}

/* ============ ③ 今日辅食安排 ============ */
.plan-card { padding: 24rpx 24rpx 22rpx; }
.plan-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.plan-head-left { flex: 1; }
.plan-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 12rpx;
  min-width: 0;
}
.plan-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1815;
  white-space: nowrap;
}
.plan-progress-text {
  font-size: 24rpx;
  color: #6E6A65;
  margin-bottom: 14rpx;
}
.plan-progress-text .strong {
  color: #F45A20;
  font-weight: 600;
}
.progress-bar {
  height: 16rpx;
  width: 100%;
  background: #FFEAD5;
  border-radius: 8rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FFA577 0%, #FF6B35 100%);
  border-radius: 8rpx;
  transition: width 0.4s ease;
}
.plan-bowl-img {
  width: 240rpx;
  height: auto;
  flex-shrink: 0;
  margin-left: 12rpx;
  margin-top: 0;
  margin-right: -4rpx;
  align-self: center;
}

/* meal item — 竖向: head(状态行) / content(主信息) / foot(操作行) */
.meal-item {
  display: flex;
  flex-direction: column;
  padding: 16rpx 20rpx 12rpx;
  background: #FFFCF8;
  border-radius: 22rpx;
  margin-top: 12rpx;
  border: 2rpx solid rgba(255, 107, 53, 0.04);
  box-sizing: border-box;
}
.meal-item.meal-done {
  background: #FFFCF8;
  border-color: rgba(91, 186, 71, 0.10);
}

/* head: 餐次小图标 + 状态徽章 */
.meal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.meal-head-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.meal-head-right {
  font-size: 22rpx;
  color: var(--orange);
  padding: 6rpx 4rpx 6rpx 12rpx;
  font-weight: 500;
}
.meal-head-right:active { opacity: 0.55; }
.meal-bowl-img {
  width: 48rpx;
  height: auto;
  flex-shrink: 0;
}
.meal-bowl-img:active { transform: scale(0.92); }
.meal-no {
  font-size: 22rpx;
  color: var(--text-meta);
  font-weight: 600;
}
.meal-badge-custom {
  display: inline-block;
  font-size: 18rpx;
  color: #FFFFFF;
  background: var(--orange-grad);
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 600;
}
.meal-badge-ok {
  display: inline-block;
  font-size: 18rpx;
  color: var(--green);
  background: var(--green-bg);
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

/* content: 主信息区 */
.meal-content { padding: 2rpx 0 4rpx; }
.meal-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1815;
  line-height: 1.3;
}
.meal-ings {
  font-size: 22rpx;
  color: #6E6A65;
  line-height: 1.4;
  margin-top: 4rpx;
  /* 长食材列表多行兜底: 最多 2 行 + 省略 */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}
.meal-plan-hint {
  font-size: 20rpx;
  color: var(--text-meta);
  margin-top: 4rpx;
}
.meal-portion-tag {
  display: inline-block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--orange);
  background: var(--bg-warm-pill);
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
}
.meal-trial {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}
.meal-trial-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #FFFFFF;
  background: var(--orange-grad);
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.meal-trial-text {
  font-size: 22rpx;
  color: #B5601A;
  line-height: 1.35;
}

/* foot: 操作行(底部全宽分布) */
.meal-foot {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(255, 107, 53, 0.06);
}
.meal-foot-spacer { flex: 1; }
.meal-foot-primary {
  height: 60rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  background: var(--orange-grad);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  box-shadow: var(--shadow-orange-soft);
}
.meal-foot-primary:active { opacity: 0.9; transform: scale(0.98); }
.meal-foot-secondary {
  height: 60rpx;
  padding: 0 20rpx;
  border-radius: 30rpx;
  background: var(--bg-warm-pill);
  color: var(--orange-deep);
  font-size: 24rpx;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
}
.meal-foot-secondary:active { background: var(--bg-promo); }

.meal-add-row {
  margin-top: 16rpx;
  padding: 22rpx 0;
  border: 2rpx dashed #E2C9A7;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #B17B2E;
  font-size: 26rpx;
  font-weight: 500;
}
.meal-add-row:active { background: #FFF8E8; transform: scale(0.99); }
.meal-add-ico {
  font-size: 32rpx;
  line-height: 1;
}
.meal-add-text {
  line-height: 1;
}
.meal-foot-feedback {
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 26rpx;
  background: #FFF8E8;
  color: #B17B2E;
  font-size: 22rpx;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
}
.meal-foot-feedback.tag-pref-love { background: #FFF0E0; color: #C45A14; }
.meal-foot-feedback.tag-pref-dislike { background: #F0F0F0; color: #6E6A65; }
.meal-foot-edit {
  font-size: 22rpx;
  color: var(--orange);
  padding: 6rpx 8rpx;
}
.meal-foot-edit:active { opacity: 0.6; }
.meal-foot-undo {
  font-size: 22rpx;
  color: var(--text-meta);
  padding: 6rpx 8rpx;
}
.meal-foot-undo:active { opacity: 0.6; }

/* tags */
.tag {
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  line-height: 44rpx;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}
.tag-done {
  background: transparent;
  color: #5BBA47;
  padding-left: 0;
  padding-right: 4rpx;
  font-weight: 600;
  font-size: 22rpx;
  height: 56rpx;
  line-height: 56rpx;
}
.tag-link { background: #FFEFE2; color: #F45A20; }
.tag-feedback {
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 2rpx solid #B4E5A4;
  color: #5BBA47;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 52rpx;
}
.tag-pref-like { background: #E6F7E0; color: #5BBA47; border: none; }
.tag-pref-dislike { background: #F2EEE8; color: #6E6A65; border: none; }

/* .plan-tip / .tomorrow-bell 沿用 .tip-row 视觉（全局） */
.plan-tip,
.tomorrow-bell {
  margin-top: 12rpx;
  padding: 10rpx 16rpx;
  background: var(--bg-tip);
  border-radius: 16rpx;
  font-size: 20rpx;
  color: var(--text-yellow);
  display: flex;
  gap: 6rpx;
  align-items: center;
  line-height: 1.4;
}
.plan-tip-ico,
.tomorrow-bell-ico { flex-shrink: 0; }
.plan-tip-text,
.tomorrow-bell-text { flex: 1; }
.plan-tip-text { flex: 1; }

/* ============ ④ 今日建议 —— 决策中心（橙桃底 + 对话气泡 + 双CTA） ============ */
.advice-card {
  background: var(--bg-promo);
  padding: 24rpx 22rpx 18rpx;
  border: 2rpx solid rgba(255, 107, 53, 0.10);
  box-shadow: 0 6rpx 18rpx rgba(255, 107, 53, 0.08);
}
.advice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.advice-h {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1815;
  letter-spacing: 0.3rpx;
}
.advice-tag {
  font-size: 20rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: var(--orange-grad);
  padding: 4rpx 14rpx;
  border-radius: 18rpx;
  letter-spacing: 0.3rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 53, 0.22);
}

/* 对话气泡 layout：mascot 左 + 白色气泡右 */
.advice-body {
  display: flex;
  align-items: flex-start;
  gap: 0;
  margin-bottom: 14rpx;
}
.advice-mascot {
  flex-shrink: 0;
  width: 108rpx;
  height: 108rpx;
  margin-top: 8rpx;
}
.advice-bubble {
  flex: 1;
  min-width: 0;
  position: relative;
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 16rpx 18rpx;
  margin-left: 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(20, 16, 12, 0.04);
}
.advice-bubble-tail {
  position: absolute;
  left: -14rpx;
  top: 36rpx;
  width: 0;
  height: 0;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  border-right: 14rpx solid #FFFFFF;
}
.advice-main {
  font-size: 28rpx;
  line-height: 1.35;
  color: #1A1815;
  font-weight: 700;
  margin-bottom: 6rpx;
}
.advice-desc {
  font-size: 22rpx;
  line-height: 1.45;
  color: #6E6A65;
}

/* chips —— 在橙桃底卡上换白底，跟气泡呼应 */
.advice-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 14rpx;
}
.chip {
  flex: 0 1 auto;
  min-height: 44rpx;
  padding: 6rpx 14rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  color: #B17B2E;
  font-size: 20rpx;
  line-height: 1.3;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  white-space: nowrap;
}
.chip-emoji { font-size: 20rpx; flex-shrink: 0; }

/* 双 CTA actions 行：secondary 浅款 + primary 橙款，并排撑满 */
.advice-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 4rpx;
}
.advice-cta-primary,
.advice-cta-secondary {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.3rpx;
}
.advice-cta-primary {
  background: var(--orange-grad);
  color: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(255, 107, 53, 0.28);
}
.advice-cta-primary:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 53, 0.20);
}
.advice-cta-secondary {
  background: #FFFFFF;
  color: #6E6A65;
  border: 2rpx solid rgba(20, 16, 12, 0.06);
}
.advice-cta-secondary:active {
  background: #F7F3EE;
}

/* "还有 N 个建议" 链接 — 推荐态独有，引导查看全部 sheet */
.advice-more-link {
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--orange-deep);
  font-weight: 500;
  padding: 8rpx 0;
}
.advice-more-link:active {
  opacity: 0.6;
}

/* ============ ⑤ 明日预告 ============ */
.tomorrow-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.tomorrow-head-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.tomorrow-h {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1815;
}
.meal-preview-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.meal-preview {
  background: #FFFAF0;
  border: 2rpx solid rgba(255, 168, 80, 0.10);
  border-radius: 22rpx;
  padding: 20rpx 18rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.meal-preview-foot {
  display: flex;
  justify-content: flex-end;
  margin-top: 4rpx;
}
.meal-preview-foot .meal-foot-secondary {
  height: 48rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  border-radius: 24rpx;
}
.meal-preview-body { flex: 1; min-width: 0; }
.meal-preview-no {
  font-size: 20rpx;
  color: #A6A19B;
  font-weight: 600;
  margin-bottom: 8rpx;
  letter-spacing: 0.3rpx;
}
.meal-preview-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1815;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.meal-preview-ings {
  font-size: 22rpx;
  color: #8A847E;
  line-height: 1.4;
}
/* meal-preview-swap 老样式弃用, 改用 .meal-preview-foot + .meal-foot-secondary 与首页统一 */
.meal-preview-emoji {
  flex-shrink: 0;
  font-size: 60rpx;
  line-height: 1;
}
.meal-preview-illust {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
}
.tomorrow-bell {
  margin-top: 12rpx;
  padding: 10rpx 16rpx;
  background: #FFF8E8;
  border-radius: 16rpx;
  font-size: 20rpx;
  color: #B17B2E;
  display: flex;
  gap: 6rpx;
  align-items: center;
  line-height: 1.4;
}
.tomorrow-bell-ico { flex-shrink: 0; }
.tomorrow-bell-text { flex: 1; }

/* ============ Alert cards (排敏/重试/空状态) ============ */
.alert-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(20, 16, 12, 0.04);
}
.alert-blue { border-left: 6rpx solid #4A90E2; }
.alert-green { border-left: 6rpx solid #43A36A; }
.alert-yellow { border-left: 6rpx solid #E89A2C; }
.alert-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.alert-icon { font-size: 28rpx; }
.alert-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1815;
  flex: 1;
}
.alert-meta {
  font-size: 22rpx;
  color: #6E6A65;
  margin-bottom: 12rpx;
}
.alert-content {
  font-size: 24rpx;
  color: #6E6A65;
  margin-bottom: 8rpx;
  line-height: 1.5;
}
.alert-actions {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.alert-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-top: 2rpx solid rgba(20, 16, 12, 0.05);
}
.alert-meal {
  font-size: 26rpx;
  color: #1A1815;
}
.alert-btn {
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  font-size: 22rpx;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
}
.alert-btn-pass {
  background: #E6F4EC;
  color: #43A36A;
}
.alert-btn-abort {
  background: #FFE9DE;
  color: #F45A20;
}
.alert-cta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #FF6B35;
  font-weight: 500;
}

/* ============ Rec detail (按需展开) ============ */
.rec-detail-card { padding: 28rpx; }
.rec-card-sub {
  font-size: 22rpx;
  color: #A6A19B;
  margin-bottom: 16rpx;
}
.rec-block { margin-bottom: 16rpx; }
.rec-block-header {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 10rpx;
}
.rec-cat-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1815;
}
.rec-cat-reason {
  font-size: 20rpx;
  color: #6E6A65;
}
.rec-foods {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.rec-food-pill {
  height: 50rpx;
  padding: 0 20rpx;
  border-radius: 25rpx;
  background: #FFF5EC;
  color: #F45A20;
  font-size: 22rpx;
  line-height: 50rpx;
  font-weight: 500;
}

/* ============ Status Sheet ============ */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
}
.sheet-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx 60rpx;
  z-index: 1000;
  transform: translateY(100%);
  transition: transform 0.28s ease-out;
}
.sheet-show { transform: translateY(0); }
.sheet-handle {
  width: 80rpx;
  height: 8rpx;
  background: #E5E0D8;
  border-radius: 4rpx;
  margin: 0 auto 20rpx;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1815;
  margin-bottom: 6rpx;
}
.sheet-desc {
  font-size: 24rpx;
  color: #6E6A65;
  margin-bottom: 24rpx;
}
.sheet-banner {
  background: var(--bg-tip);
  border-radius: 18rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.sheet-banner-text {
  font-size: 22rpx;
  color: #B17B2E;
  line-height: 1.5;
}
.sheet-banner-cta {
  align-self: flex-end;
  font-size: 22rpx;
  color: var(--orange);
  font-weight: 600;
  padding: 4rpx 8rpx;
}
.sheet-banner-cta:active { opacity: 0.6; }
.sheet-options { display: flex; flex-direction: column; gap: 16rpx; }
.sheet-option {
  display: flex;
  gap: 16rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #FFFCF8;
  border: 2rpx solid rgba(255, 107, 53, 0.06);
}
.sheet-option-active {
  background: #FFEFE2;
  border-color: #FF6B35;
}
.sheet-option-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.sheet-option-body { flex: 1; }
.sheet-option-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1815;
  margin-bottom: 4rpx;
}
.sheet-option-desc {
  font-size: 22rpx;
  color: #6E6A65;
  line-height: 1.4;
}
.sheet-cancel {
  margin-top: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #6E6A65;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #F7F3EE;
}

/* ============ 换菜 sheet ============ */
/* 换菜 sheet — 线框稿: 半屏 55% + 顶部标题栏 + Hero 卡 + 折叠备选 + 底部链接 */
.repl-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
}
.repl-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 82vh;
  background: var(--bg-page);
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.repl-handle {
  width: 72rpx;
  height: 6rpx;
  background: #D9D5CE;
  border-radius: 3rpx;
  margin: 14rpx auto 12rpx;
  flex-shrink: 0;
}

/* 顶部标题栏: 左关闭 + 主标题(原计划inline 副标题) */
.repl-topbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 4rpx 24rpx 16rpx;
  flex-shrink: 0;
}
.repl-close {
  width: 56rpx;
  height: 56rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--text-body);
  flex-shrink: 0;
}
.repl-close:active { color: var(--orange); }
.repl-close-x {
  font-size: 32rpx;
  color: var(--text-mute);
  margin-left: 8rpx;
}
.repl-titles {
  flex: 1;
  min-width: 0;
}
.repl-title-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  flex-wrap: wrap;
}
.repl-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-h1);
  line-height: 1.2;
}
.repl-sub {
  font-size: 22rpx;
  color: var(--text-meta);
}

/* body: 滚动区 */
.repl-body {
  flex: 1;
  overflow-y: auto;
  padding: 0 24rpx 16rpx;
}

/* 互换区: 紧凑 inline 风, 不画卡 */
.repl-swap-inline {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 14rpx;
  padding: 0 2rpx;
}
.repl-swap-inline-label {
  font-size: 22rpx;
  color: var(--text-meta);
  flex-shrink: 0;
}
.repl-swap-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.repl-swap-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 18rpx;
  background: var(--bg-warm-pill);
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  color: var(--text-body);
}
.repl-swap-pill:active { background: var(--bg-promo); }
.repl-swap-no {
  color: var(--orange);
  font-weight: 600;
}

/* Hero 推荐卡: 浅橙桃底 + 大菜名 + ✅ list + 立即替换大按钮 */
.repl-hero {
  background: var(--bg-promo);
  border-radius: var(--radius-card);
  padding: 22rpx 24rpx 20rpx;
  margin-bottom: 14rpx;
  box-shadow: var(--shadow-card);
}
.repl-hero-badge {
  font-size: 22rpx;
  color: var(--orange-deep);
  font-weight: 600;
  margin-bottom: 8rpx;
}
.repl-hero-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-h1);
  line-height: 1.25;
  margin-bottom: 4rpx;
}
.repl-hero-ings {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.4;
  margin-bottom: 14rpx;
}
.repl-hero-reasons {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 12rpx;
}
.repl-hero-reason {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}
.repl-hero-reason-icon {
  font-size: 22rpx;
  flex-shrink: 0;
  line-height: 1.4;
}
.repl-hero-reason-text {
  font-size: 24rpx;
  color: var(--text-body);
  line-height: 1.4;
}
.repl-hero-warn {
  font-size: 22rpx;
  color: #B17B2E;
  background: var(--bg-tip);
  padding: 8rpx 14rpx;
  border-radius: 14rpx;
  line-height: 1.4;
  margin-bottom: 10rpx;
}
.repl-hero-meta {
  font-size: 22rpx;
  color: var(--text-meta);
}
/* CTA: sticky 在 sheet 底部, 不再嵌 hero 卡 */
.repl-hero-cta {
  display: flex;
  width: 100%;
  height: 84rpx;
  border-radius: var(--radius-btn);
  background: var(--orange-grad);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-orange);
  box-sizing: border-box;
}
.repl-hero-cta:active { transform: scale(0.98); opacity: 0.92; }

/* 备选区: 默认展开, 一张白卡装多行 */
.repl-alts-label {
  font-size: 22rpx;
  color: var(--text-meta);
  padding: 0 4rpx;
  margin-bottom: 8rpx;
}
.repl-alts-list {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  margin-bottom: 12rpx;
}
.repl-alt {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 22rpx;
  border-bottom: 1rpx solid #F5F2EC;
}
.repl-alt:last-child { border-bottom: none; }
.repl-alt:active { background: var(--bg-soft); }
.repl-alt-body {
  flex: 1;
  min-width: 0;
}
.repl-alt-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-h1);
  margin-bottom: 2rpx;
}
.repl-alt-ings {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.35;
}
.repl-alt-mark {
  flex-shrink: 0;
  font-size: 28rpx;
}
.repl-alt-mark-ok { color: var(--green); }
.repl-alt-mark-warn { color: #E89A2C; }

.repl-empty {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-meta);
  font-size: 24rpx;
}

/* 底部 sticky bar: 灰链接(再换一组) 上方, 主 CTA 下方 */
.repl-footer {
  flex-shrink: 0;
  padding: 12rpx 24rpx 28rpx;
  background: var(--bg-page);
  border-top: 1rpx solid rgba(255, 107, 53, 0.08);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.repl-footer-link {
  align-self: center;
  font-size: 22rpx;
  color: var(--text-meta);
  padding: 6rpx 16rpx;
}
.repl-footer-link:active { color: var(--orange); }
.repl-footer-actions {
  display: flex;
  gap: 12rpx;
  align-items: stretch;
}
.repl-footer-cancel {
  flex: 0 0 28%;
  text-align: center;
  background: #FFFFFF;
  color: var(--text-h1);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: var(--radius-btn);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.repl-footer-cancel:active { opacity: 0.7; }
.repl-footer-actions .repl-hero-cta {
  flex: 1;
}

/* ==== 「全部排敏建议」sheet 内独有元素 ==== */
.repl-head {
  padding: 0 24rpx 16rpx;
  flex-shrink: 0;
}
.repl-list {
  flex: 1;
  overflow-y: auto;
  padding: 0 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.repl-card {
  background: var(--bg-card);
  border-radius: 22rpx;
  padding: 18rpx 22rpx;
  box-shadow: 0 2rpx 10rpx rgba(255, 107, 53, 0.05);
  border: 1rpx solid rgba(255, 107, 53, 0.08);
}
.repl-card:active { opacity: 0.7; }
.repl-card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
  gap: 10rpx;
}
.repl-rank {
  background: var(--bg-warm-pill);
  color: var(--orange);
  padding: 4rpx 12rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.repl-reason {
  font-size: 22rpx;
  color: var(--text-mute);
}
.repl-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-h1);
  margin-bottom: 4rpx;
}
.repl-ings {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}
.repl-actions {
  flex-shrink: 0;
  padding: 12rpx 24rpx 28rpx;
  background: var(--bg-page);
  border-top: 1rpx solid rgba(255, 107, 53, 0.08);
}
.repl-action {
  width: 100%;
  text-align: center;
  padding: 22rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
}

/* ==== 「记录吃了」实际记录 sheet ==== */
.act-sheet { /* 复用 .repl-sheet 基础布局, 用 max-height 自适应 (内容少时不撑高出留白) */ }
.act-head {
  padding: 4rpx 24rpx 14rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.act-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-h1);
  flex: 1;
  min-width: 0;
}
.act-body {
  /* scroll-view 内联设 max-height: calc(82vh - 230rpx) 让内容超出时滚动,
     内容少时高度跟内容自适应 (不撑高 sheet) */
  padding: 0 24rpx 8rpx;
  box-sizing: border-box;
}

/* 计划餐速记区 */
/* 顶部计划餐紧凑条: 浅橙桃底单行 emoji+菜名+食材+做法链接 */
.act-plan-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--bg-promo);
  border-radius: 20rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 16rpx;
}
.act-plan-bar:active { opacity: 0.85; }
.act-plan-bar-emoji {
  font-size: 28rpx;
  flex-shrink: 0;
}
.act-plan-bar-text {
  flex: 1;
  min-width: 0;
}
.act-plan-bar-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-h1);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.act-plan-bar-ings {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 2rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.act-plan-bar-link {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--orange);
  font-weight: 500;
}

/* 信息卡: 时间 + 份量整合 (主交互区) */
.act-card {
  background: #FFFFFF;
  border-radius: 22rpx;
  padding: 4rpx 22rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(255, 107, 53, 0.08);
}
.act-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  gap: 12rpx;
}
.act-field-stack {
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}
.act-field-label {
  font-size: 26rpx;
  color: var(--text-body);
  font-weight: 600;
}
.act-field-value {
  font-size: 28rpx;
  color: var(--orange);
  font-weight: 500;
}
.act-field-value:active { opacity: 0.7; }
.act-divider {
  height: 1rpx;
  background: rgba(255, 107, 53, 0.08);
}

/* 折叠条: warm-pill 暖橙底, 风格与 plan-bar 一致 */
.act-details-toggle {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: var(--bg-warm-pill);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(255, 107, 53, 0.12);
}
.act-details-toggle:active { opacity: 0.7; }
.act-details-toggle.on {
  background: #FFFFFF;
  border-color: rgba(255, 107, 53, 0.2);
}
.act-details-toggle-emoji {
  font-size: 26rpx;
  flex-shrink: 0;
}
.act-details-toggle-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--orange);
  font-weight: 500;
}
.act-details-arrow {
  font-size: 22rpx;
  color: var(--orange);
  transition: transform 0.2s;
}
.act-details-arrow.open { transform: rotate(180deg); }
.act-details {
  margin-bottom: 16rpx;
}
/* details 卡底部轻收起链接 (替代展开后顶部那条"收起"长条) */
.act-details-collapse {
  text-align: center;
  padding: 16rpx 0 4rpx;
  font-size: 22rpx;
  color: var(--text-mute);
}
.act-details-collapse:active { color: var(--orange); }
.act-details-collapse-text { letter-spacing: 2rpx; }

/* section 小标题 */
.act-section-label {
  font-size: 24rpx;
  color: var(--text-body);
  font-weight: 600;
  margin: 10rpx 0 8rpx;
}

/* 输入框 */
.act-input-wrap {
  position: relative;
  margin-bottom: 14rpx;
}
.act-input {
  width: 100%;
  height: 76rpx;
  padding: 0 60rpx 0 20rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(255, 107, 53, 0.16);
  border-radius: 18rpx;
  font-size: 26rpx;
  color: var(--text-body);
  box-sizing: border-box;
}
.act-input-clear {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: #E5E0D8;
  color: #FFFFFF;
  font-size: 24rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* 食材 chip */
.act-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 14rpx;
}
.act-chip {
  padding: 10rpx 22rpx;
  border-radius: 36rpx;
  font-size: 24rpx;
  color: var(--text-body);
  background: #FFFFFF;
  border: 2rpx solid #ECE6DC;
}
.act-chip-on {
  background: var(--bg-warm-pill);
  color: var(--orange-deep);
  border-color: var(--orange);
  font-weight: 600;
}
.act-chip-add {
  color: var(--text-meta);
  border-style: dashed;
}
.act-chip-add:active { color: var(--orange); border-color: var(--orange); }

/* 份量 4 选 1 */
.act-portions {
  display: flex;
  gap: 10rpx;
  margin-bottom: 14rpx;
}
.act-portion {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 64rpx;
  background: #FFFFFF;
  border: 2rpx solid #ECE6DC;
  border-radius: 36rpx;
  font-size: 24rpx;
  color: var(--text-body);
}
.act-portion-emoji { font-size: 24rpx; }
.act-portion-on {
  background: var(--bg-warm-pill);
  border-color: var(--orange);
  color: var(--orange-deep);
  font-weight: 600;
}

/* 备注 */
.act-note-wrap {
  position: relative;
}
.act-note {
  width: 100%;
  height: 120rpx;
  padding: 14rpx 20rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(255, 107, 53, 0.16);
  border-radius: 18rpx;
  font-size: 24rpx;
  color: var(--text-body);
  box-sizing: border-box;
}
.act-note-counter {
  position: absolute;
  right: 16rpx;
  bottom: 10rpx;
  font-size: 20rpx;
  color: var(--text-meta);
}

/* 份量提示 (爱吃推断说明) */
.act-portion-hint {
  font-size: 22rpx;
  color: var(--orange);
  background: var(--bg-warm-pill);
  padding: 8rpx 16rpx;
  border-radius: 14rpx;
  margin: 10rpx 0 4rpx;
  text-align: center;
}

/* (act-details-toggle 老虚线样式已弃用, 见上方新 warm-pill 版) */

/* act-row: 用餐时间 picker 一行 */
.act-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F4EFE8;
  margin-bottom: 8rpx;
}
.act-row-label {
  font-size: 26rpx;
  color: var(--text-body);
  font-weight: 600;
}
.act-row-pick {
  font-size: 28rpx;
  color: var(--orange);
  font-weight: 500;
}
.act-row-pick:active { opacity: 0.7; }

/* ============ disclaimer ============ */
.disclaimer {
  text-align: center;
  font-size: 18rpx;
  color: var(--text-faint);
  padding: 8rpx 24rpx 4rpx;
  margin: 8rpx 0 0;
  line-height: 1.4;
}

/* ============ 补一餐 sheet (与 review manualSheet 同款) ============ */
.manual-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 88vh;
  background: var(--bg-page);
  border-radius: 32rpx 32rpx 0 0;
  /* 与 .repl-mask(999) 配套，确保弹窗可交互且点击不会落到遮罩上 */
  z-index: 1000;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.manual-handle {
  width: 72rpx;
  height: 6rpx;
  background: #D9D5CE;
  border-radius: 3rpx;
  margin: 14rpx auto 12rpx;
  flex-shrink: 0;
}
.manual-head {
  padding: 4rpx 24rpx 16rpx;
  flex-shrink: 0;
}
.manual-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-h1);
}
.manual-sub {
  font-size: 22rpx;
  color: var(--text-meta);
  margin-top: 4rpx;
}
.manual-body {
  flex: 1;
  overflow-y: auto;
  padding: 0 24rpx 16rpx;
}
.manual-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(255, 107, 53, 0.08);
}
.manual-row:last-of-type { border-bottom: none; }
.manual-label {
  font-size: 26rpx;
  color: var(--text-body);
  font-weight: 500;
}
.manual-pick {
  font-size: 26rpx;
  color: var(--orange);
  padding: 4rpx 6rpx;
}
.manual-section-label {
  font-size: 24rpx;
  color: var(--text-body);
  font-weight: 600;
  margin: 14rpx 0 8rpx;
}
.manual-input {
  width: 100%;
  height: 76rpx;
  padding: 0 20rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(255, 107, 53, 0.16);
  border-radius: 18rpx;
  font-size: 26rpx;
  color: var(--text-body);
  box-sizing: border-box;
}
.ing-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}
.ing-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background: var(--bg-warm-pill);
  border: 2rpx solid rgba(255, 107, 53, 0.18);
  border-radius: 22rpx;
  font-size: 24rpx;
  color: var(--orange);
}
.ing-chip:active { opacity: 0.7; }
.ing-chip-x {
  font-size: 20rpx;
  color: var(--orange);
  opacity: 0.6;
  margin-left: 2rpx;
}
.ing-input-row {
  display: flex;
  gap: 10rpx;
  align-items: stretch;
}
.ing-input {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  box-sizing: border-box;
}
.ing-add-btn {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #FF8C61 0%, #FF6B35 100%);
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 53, 0.25);
}
.ing-add-btn:active { opacity: 0.85; }
.ing-sugs {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
}
.ing-sugs-label {
  font-size: 22rpx;
  color: var(--text-mute);
  margin-right: 4rpx;
}
.ing-sug {
  padding: 6rpx 14rpx;
  background: #FFFFFF;
  border: 1rpx dashed rgba(255, 107, 53, 0.32);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: var(--text-body);
}
.ing-sug:active { opacity: 0.6; background: var(--bg-warm-pill); }

.manual-portions {
  display: flex;
  gap: 10rpx;
}
.manual-portion {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border: 2rpx solid #ECE6DC;
  border-radius: 36rpx;
  font-size: 22rpx;
  color: var(--text-body);
}
.manual-portion.on {
  background: var(--bg-warm-pill);
  border-color: var(--orange);
  color: var(--orange-deep);
  font-weight: 600;
}
.manual-portion-hint {
  margin-top: 12rpx;
  padding: 12rpx 18rpx;
  background: #FFF8E8;
  color: #B17B2E;
  border-radius: 18rpx;
  font-size: 22rpx;
  line-height: 1.5;
}
.manual-textarea {
  width: 100%;
  height: 110rpx;
  padding: 14rpx 20rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(255, 107, 53, 0.16);
  border-radius: 18rpx;
  font-size: 24rpx;
  color: var(--text-body);
  box-sizing: border-box;
}
.manual-footer {
  flex-shrink: 0;
  display: flex;
  gap: 14rpx;
  padding: 12rpx 24rpx 28rpx;
  background: var(--bg-page);
  border-top: 1rpx solid rgba(255, 107, 53, 0.08);
}
.manual-cancel {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  background: var(--bg-card);
  color: var(--text-body);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.manual-save {
  flex: 2;
  height: 80rpx;
  border-radius: 40rpx;
  background: var(--orange-grad);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-orange);
}
.manual-save:active { opacity: 0.9; }
