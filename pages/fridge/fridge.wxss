/* ============================================
   冰箱 v2 完整版 · 设计图实现
   全局 .card / .btn-* / .row / .text-* / token 见 app.wxss
   ============================================ */

.page-bg { padding-bottom: 200rpx; }

/* ============ Onboard hint ============ */
.onboard-hint {
  background: var(--bg-promo);
  box-shadow: none;
  text-align: center;
  padding: 40rpx 24rpx;
  margin-top: 24rpx;
}

/* ============ Hero 卡 ============ */
.hero-card {
  margin-top: 24rpx;
  padding: 26rpx 28rpx 22rpx;
}
.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.hero-title-wrap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-h1);
  letter-spacing: 0.5rpx;
}
.hero-count {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--orange);
  margin: 0 4rpx;
}
.hero-unit {
  font-size: 26rpx;
  color: var(--text-h1);
  font-weight: 600;
}
.hero-cta {
  background: var(--orange-grad);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 22rpx;
  border-radius: 28rpx;
  box-shadow: var(--shadow-orange-soft);
  flex-shrink: 0;
}

.hero-pills {
  display: flex;
  gap: 12rpx;
  margin-bottom: 14rpx;
}
.hero-pill {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 12rpx 8rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.hero-pill-ico { font-size: 22rpx; }
.hero-pill-label { font-size: 22rpx; }
.hero-pill-num { font-size: 26rpx; font-weight: 700; margin-left: 2rpx; }

.hero-pill-urgent {
  background: var(--bg-warm-pill);
  color: var(--orange-deep);
}
.hero-pill-low {
  background: #FFEDD9;
  color: #B17B2E;
}
.hero-pill-advice {
  background: var(--warn-bg);
  color: var(--warn);
}

.hero-tagline {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--text-meta);
  padding-top: 4rpx;
}
.hero-tagline-ico { font-size: 20rpx; }

/* ============ Toolbar（搜索 + 批量管理） ============ */
.toolbar-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.search-box {
  flex: 1;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 72rpx;
  box-shadow: var(--shadow-card);
}
.search-ico {
  font-size: 26rpx;
  color: var(--text-mute);
  flex-shrink: 0;
}
.search-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-h1);
  height: 72rpx;
}
.batch-btn {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 0 22rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  box-shadow: var(--shadow-card);
  flex-shrink: 0;
}
.batch-btn-on {
  background: var(--orange);
  color: #FFFFFF;
}
.batch-ico { font-size: 22rpx; }

/* ============ 位置 segment tabs ============ */
.loc-tabs {
  display: flex;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}
.loc-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0 14rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
}
.loc-tab-active {
  color: var(--orange);
  font-weight: 600;
}
.loc-tab-active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--orange);
  transform: translateX(-50%);
}

/* ============ 筛选 chips + 排序 ============ */
.chip-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.chip-scroll {
  flex: 1;
  display: flex;
  gap: 10rpx;
  overflow-x: auto;
  white-space: nowrap;
}
.filter-chip {
  padding: 10rpx 22rpx;
  background: #FFFFFF;
  color: var(--text-secondary);
  border-radius: 26rpx;
  font-size: 24rpx;
  box-shadow: var(--shadow-card);
  flex-shrink: 0;
}
.filter-chip-active {
  background: var(--bg-warm-pill);
  color: var(--orange);
  font-weight: 600;
  box-shadow: none;
  border: 2rpx solid var(--orange);
}
.sort-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  flex-shrink: 0;
  padding: 8rpx 8rpx 8rpx 12rpx;
}
.sort-ico { font-size: 22rpx; }

/* ============ 优先处理卡 ============ */
.priority-card {
  border: 2rpx solid #FFEDD9;
}
.priority-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14rpx;
  margin-bottom: 6rpx;
  border-bottom: 1rpx dashed #F5E0CC;
}
.priority-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--orange-deep);
}
.priority-ico { font-size: 26rpx; }
.priority-num {
  font-size: 22rpx;
  color: var(--text-mute);
  font-weight: 500;
}
.priority-link {
  font-size: 22rpx;
  color: var(--orange);
  font-weight: 500;
}

/* ============ 食材行通用 ============ */
.fr-item-block {
  border-bottom: 1rpx solid #F4EEE7;
  padding: 16rpx 0;
}
.fr-item-block:last-child { border-bottom: none; padding-bottom: 4rpx; }
.fr-item-block:first-child { padding-top: 12rpx; }

.fr-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.select-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #DDDDDD;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 24rpx;
  flex-shrink: 0;
}
.select-box-on {
  background: var(--orange);
  border-color: var(--orange);
}

.fr-item-main {
  flex: 1;
  min-width: 0;
}
.fr-item-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
  flex-wrap: wrap;
}
.fr-item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-h1);
}
.loc-pill {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 14rpx;
  font-weight: 500;
  white-space: nowrap;
}
.loc-pill-frozen        { background: #E3F2FD;        color: #2196F3; }
.loc-pill-refrigerated  { background: #E0F2FE;        color: #0EA5E9; }
.loc-pill-room          { background: var(--warn-bg); color: var(--warn); }
.tip-icon {
  font-size: 22rpx;
  opacity: 0.7;
}
.fr-item-meta {
  font-size: 22rpx;
  color: var(--text-meta);
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.meta-dot { color: var(--text-faint); }
.fr-item-expiry { color: var(--text-meta); }
.expiry-expired { color: #E57373; font-weight: 600; }
.expiry-urgent  { color: var(--orange-deep); font-weight: 600; }
.expiry-far     { color: var(--green); }

/* ============ 状态 badge ============ */
.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 12rpx;
  border-radius: 14rpx;
  font-size: 20rpx;
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
}
.status-badge-urgent {
  background: #FFEBEE;
  color: #E57373;
}
.status-badge-low {
  background: var(--bg-warm-pill);
  color: var(--orange);
}
.status-badge-ico { font-size: 18rpx; }

/* ============ 步进控件 ============ */
.stepper {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 2rpx solid #F0E5D8;
  border-radius: 30rpx;
  padding: 4rpx 6rpx;
  gap: 4rpx;
  flex-shrink: 0;
}
.step-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--orange);
  font-weight: 600;
  background: #FFFAF3;
}
.step-btn:active {
  background: var(--bg-promo);
  transform: scale(0.95);
}
.step-num {
  min-width: 80rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-h1);
  font-weight: 600;
}

.more-trigger {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--text-mute);
  font-weight: 600;
  letter-spacing: 0;
  flex-shrink: 0;
}
.more-trigger:active { color: var(--orange); }

/* ============ Tip 展开卡 ============ */
.tip-card {
  background: var(--bg-warm);
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  margin: 12rpx 0 4rpx;
  border-left: 4rpx solid var(--orange);
}
.tip-line {
  font-size: 24rpx;
  color: var(--orange);
  font-weight: 500;
  margin-bottom: 4rpx;
}
.tip-content {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.empty {
  text-align: center;
  color: var(--text-meta);
  padding: 50rpx 0;
}

/* ============ More 菜单弹层 ============ */
.more-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
}
.more-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 24rpx 30rpx;
  z-index: 1000;
}
.more-handle {
  width: 80rpx;
  height: 6rpx;
  background: #E5E0D8;
  border-radius: 3rpx;
  margin: 0 auto 16rpx;
}
.more-list {
  background: #FFFAF3;
  border-radius: 20rpx;
  overflow: hidden;
}
.more-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 22rpx;
  font-size: 28rpx;
  color: var(--text-h1);
  border-bottom: 1rpx solid #F5EBE0;
}
.more-row:last-child { border-bottom: none; }
.more-row-ico {
  font-size: 26rpx;
  width: 32rpx;
  text-align: center;
}
.more-row:active { background: var(--bg-promo); }
.more-row-danger { color: #E57373; }

.more-cancel {
  margin-top: 14rpx;
  text-align: center;
  background: #F7F3EE;
  color: var(--text-secondary);
  padding: 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
}

/* ============ 编辑 sheet ============ */
.edit-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx 30rpx;
  z-index: 1000;
}
.edit-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-h1);
  margin-bottom: 18rpx;
}
.edit-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}
.edit-label {
  width: 120rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.edit-input {
  flex: 1;
  background: var(--bg-soft);
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  font-size: 26rpx;
  color: var(--text-h1);
}
.edit-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.edit-btn {
  flex: 1;
  margin: 0;
  height: 76rpx;
}

/* ============ 批量底部操作栏 ============ */
.batch-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 18rpx 24rpx 30rpx;
  border-top: 1rpx solid #F0E5D8;
  box-shadow: 0 -6rpx 20rpx rgba(0,0,0,0.06);
  z-index: 80;
}
.batch-count {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}
.batch-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}
.batch-link {
  font-size: 24rpx;
  color: var(--orange);
  padding: 8rpx 12rpx;
}
.batch-action-btn {
  flex: 1;
  background: var(--orange);
  color: #FFFFFF;
  text-align: center;
  padding: 16rpx;
  border-radius: 22rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.batch-action-danger { background: #E57373; }
