/* AI 助手 — 跟全局 v2 token 保持一致
   暖蜜桃底 + 圆角 + 主橙,只写页面独有 */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-page, #FFF5EB);
}

.messages {
  flex: 1;
  padding: 24rpx 24rpx 16rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.row {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.row-user {
  justify-content: flex-end;
}

.row-ai {
  justify-content: flex-start;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.avatar-user {
  background: var(--orange, #FF6B35);
  color: #FFFFFF;
  margin-left: 16rpx;
}

.avatar-ai {
  background: var(--bg-promo, #FFEDD9);
  margin-right: 16rpx;
}

.bubble {
  max-width: 76%;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  line-height: 1.55;
  word-break: break-word;
}

.bubble-user {
  background: var(--orange, #FF6B35);
  color: #FFFFFF;
  border-bottom-right-radius: 6rpx;
}

.bubble-ai {
  background: var(--bg-card, #FFFFFF);
  color: var(--text-body, #2D1B0E);
  border-bottom-left-radius: 6rpx;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.04);
}

.ai-text {
  white-space: pre-wrap;
}

/* tool-call trace (collapsible) */
.trace {
  margin-top: 16rpx;
  border-top: 1rpx solid var(--bg-warm-pill, #FFF1E0);
  padding-top: 12rpx;
}

.trace-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4rpx 0;
}

.trace-title {
  font-size: 24rpx;
  color: var(--text-secondary, #6E6A65);
}

.trace-toggle {
  font-size: 24rpx;
  color: var(--orange, #FF6B35);
}

.trace-body {
  margin-top: 8rpx;
}

.trace-item {
  background: var(--bg-soft, #FFFCF8);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 8rpx;
}

.trace-item-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.trace-status {
  font-size: 24rpx;
  font-weight: bold;
}

.trace-status.ok { color: #5BBA47; }
.trace-status.err { color: #E04A2C; }

.trace-name {
  font-size: 26rpx;
  color: var(--text-body, #2D1B0E);
  font-weight: 500;
}

.trace-input {
  font-size: 22rpx;
  color: var(--text-meta, #8A847E);
  font-family: monospace;
  white-space: pre-wrap;
  word-break: break-all;
}

/* loading dots */
.loading {
  display: flex;
  gap: 8rpx;
  align-items: center;
  padding: 24rpx 28rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: var(--text-mute, #A6A19B);
  border-radius: 50%;
  animation: bounce 1.2s infinite;
}

.dot:nth-child(2) { animation-delay: 0.15s; }
.dot:nth-child(3) { animation-delay: 0.3s; }

@keyframes bounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
  30% { transform: translateY(-6rpx); opacity: 1; }
}

/* quick replies */
.quick {
  padding: 24rpx;
}

.ai-data-notice {
  margin: 0 24rpx 8rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-radius: 20rpx;
  background: #FFF9F1;
  border: 1rpx solid #F1D8BD;
}

.ai-data-copy {
  min-width: 0;
}

.ai-data-title {
  color: var(--text-body, #2D1B0E);
  font-size: 24rpx;
  font-weight: 600;
}

.ai-data-desc {
  margin-top: 6rpx;
  color: var(--text-meta, #8A847E);
  font-size: 21rpx;
  line-height: 1.45;
}

.ai-data-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  flex-shrink: 0;
}

.ai-data-link {
  color: var(--orange, #FF6B35);
  font-size: 23rpx;
}

.ai-data-link.danger {
  color: #C84A2F;
}

.quick-title {
  font-size: 26rpx;
  color: var(--text-secondary, #6E6A65);
  margin-bottom: 16rpx;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.quick-chip {
  background: var(--bg-card, #FFFFFF);
  border: 2rpx solid var(--bg-warm-pill, #FFF1E0);
  border-radius: 32rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  color: var(--text-body, #2D1B0E);
}

/* retry button on failed AI messages */
.retry-row {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 12rpx;
  padding: 6rpx 16rpx;
  background: var(--bg-warm-pill, #FFF1E0);
  border-radius: 20rpx;
  align-self: flex-start;
}

.retry-row:active {
  background: #FFEAD5;
}

.retry-icon {
  font-size: 28rpx;
  color: var(--orange, #FF6B35);
  font-weight: bold;
}

.retry-text {
  font-size: 24rpx;
  color: var(--orange, #FF6B35);
  font-weight: 500;
}

/* composer */
.composer {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--bg-card, #FFFFFF);
  border-top: 1rpx solid var(--bg-warm-pill, #FFF1E0);
  gap: 16rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.composer-input {
  flex: 1;
  background: var(--bg-soft, #FFFCF8);
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  font-size: 30rpx;
  height: 40rpx;
  line-height: 40rpx;
}

.composer-send {
  background: var(--bg-warm-pill, #FFF1E0);
  color: var(--text-mute, #A6A19B);
  border-radius: 32rpx;
  padding: 12rpx 28rpx;
  font-size: 28rpx;
  font-weight: 500;
  flex-shrink: 0;
  transition: background 0.15s, color 0.15s, opacity 0.15s;
}

.composer-send.active {
  background: var(--orange, #FF6B35);
  color: #FFFFFF;
}

.composer-send.loading {
  background: var(--orange-light, #FF8C61);
  color: #FFFFFF;
  opacity: 0.85;
}

.composer-send.disabled {
  opacity: 0.4;
  pointer-events: none;
}
