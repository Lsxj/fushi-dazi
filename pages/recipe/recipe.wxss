/* ============================================
   食谱详情 · v2 token baseline
   全局 .card / token 见 app.wxss
   ============================================ */

.step {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
  color: var(--text-body);
}
.step:last-child { border-bottom: none; }
.step-num {
  color: var(--orange);
  font-weight: 600;
  margin-right: 12rpx;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.taboo-card {
  background: var(--bg-tip);
}
.taboo-row {
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(225, 168, 102, 0.25);
}
.taboo-row:last-child { border-bottom: none; }
.taboo-foods {
  font-size: 26rpx;
  font-weight: 600;
  color: #B17B2E;
  margin-bottom: 4rpx;
}
.taboo-reason {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.4;
  margin-bottom: 4rpx;
}
.taboo-mitigation {
  font-size: 22rpx;
  color: var(--green);
  font-weight: 600;
}
